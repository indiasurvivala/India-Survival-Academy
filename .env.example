# India Survival Academy — Environment Configuration Example
# Copy this file to .env.local or set these variables in your Vercel Project Settings.
# IMPORTANT: Never commit your real Google App Password or secrets to source control.

# Gmail SMTP Configuration
# Host for Google's SMTP servers
SMTP_HOST=smtp.gmail.com

# SMTP Port:
# Use 587 with STARTTLS (recommended) or 465 with SSL.
SMTP_PORT=587

# Academy Gmail Account (Sender Authentication)
SMTP_USER=INDIASURVIVALA@GMAIL.COM

# Google App Password (16 characters generated from Google Account > Security > 2-Step Verification > App passwords)
# DO NOT use your standard Gmail account password.
SMTP_PASS=replace_with_google_app_password

# Dedicated Academy Recipient Address (All enquiries will be delivered ONLY here)
ENQUIRY_TO_EMAIL=INDIASURVIVALA@GMAIL.COM
